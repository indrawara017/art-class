{
  "expo": {
    "name": "art-class",
    "slug": "artclass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpeg",
    "scheme": "artclass",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo.jpeg"
    },
    "android": {
      "icon": "./assets/logo.jpeg",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/logo.jpeg",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99dbc0ea-6bd6-4fc0-b622-5ddbeabf4e0d"
      }
    },
    "owner": "indra_017"
  }
}
